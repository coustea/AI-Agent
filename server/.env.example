# App configuration
APP_DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=9999

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=agent
DB_ECHO=false

# JWT configuration
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# LLM configuration (Spark Pro via OpenAI-compatible API)
OPENAI_API_BASE=https://spark-api-open.xf-yun.com/v1/
OPENAI_API_KEY=your_api_password
OPENAI_MODEL=generalv3.5

# Fast LLM (Spark Lite) — 分类路由、任务规划等轻量任务
FAST_LLM_API_KEY=your_fast_api_password
FAST_LLM_MODEL=general

# Node.js
NODE_PATH=/path/to/node

# Path configuration (relative to server directory)
SKILLS_DIR=skills
WORKPLACE_DIR=workplace
LOGS_DIR=logs
KNOWLEDGE_BASE_DIR=data
