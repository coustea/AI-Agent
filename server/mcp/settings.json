{
  "mcpServers": {
    "markmap": {
      "description": "将 Markdown 转换为交互式思维导图 HTML 文件",
      "command": "${NODE_PATH}",
      "args": [
        "${SERVER_DIR}/mcp/markmap-mcp-server/build/index.js",
        "--output",
        "${SERVER_DIR}/workplace/mindmap"
      ],
      "transport": "stdio",
      "env": {
        "MARKMAP_DIR": "${SERVER_DIR}/workplace/mindmap"
      },
      "ensureDirs": ["${SERVER_DIR}/workplace/mindmap"],
      "mergeOsEnviron": true
    },
    "word-document-server": {
      "description": "创建、读取和操作 Microsoft Word 文档",
      "command": "python",
      "args": [
        "${MCP_DIR}/Office-Word-MCP-Server/word_mcp_server.py"
      ],
      "transport": "stdio",
      "env": {
        "PYTHONPATH": "${MCP_DIR}/Office-Word-MCP-Server",
        "MCP_TRANSPORT": "stdio"
      },
      "mergeOsEnviron": true
    }
  }
}
