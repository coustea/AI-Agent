{
  "id": "teaching-white",
  "name": "高校教学白",
  "version": "8.0.0",
  "description": "面向课堂放映的现代白色教学模板。以流程轨迹、概念卡、对照矩阵、纠错路径和关系图承载知识，全部使用原生 HTML、CSS 与基础图形，不依赖图片生成能力。",
  "family": "teaching",
  "scheme": "light",
  "tags": [
    "高校教学",
    "白色",
    "计算机课程",
    "知识讲解",
    "课堂讲义",
    "图解优先",
    "课堂放映",
    "概念复习"
  ],
  "layouts": [
    {
      "id": "white-cover",
      "name": "课程讲义封面",
      "type": "cover",
      "animation": "reveal",
      "skeleton": "course-handout-cover"
    },
    {
      "id": "white-agenda",
      "name": "学习路径",
      "type": "agenda",
      "animation": "trace",
      "skeleton": "learning-route"
    },
    {
      "id": "white-goals",
      "name": "能力目标",
      "type": "learning_goals",
      "animation": "build",
      "skeleton": "goal-progression"
    },
    {
      "id": "white-question",
      "name": "问题导入",
      "type": "hook_question",
      "animation": "focus",
      "skeleton": "question-focus"
    },
    {
      "id": "white-definition",
      "name": "概念定义",
      "type": "definition",
      "animation": "reveal",
      "skeleton": "definition-board"
    },
    {
      "id": "white-boundary",
      "name": "概念边界",
      "type": "concept_boundary",
      "animation": "compare",
      "skeleton": "boundary-axis"
    },
    {
      "id": "white-mechanism",
      "name": "机制链路",
      "type": "mechanism_overview",
      "animation": "trace",
      "skeleton": "mechanism-line"
    },
    {
      "id": "white-explain",
      "name": "知识讲解",
      "type": "knowledge_explain",
      "animation": "build",
      "skeleton": "explain-editorial"
