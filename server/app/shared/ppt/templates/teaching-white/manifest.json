      "type": "misconception",
      "animation": "resolve",
      "skeleton": "misconception-correction"
    },
    {
      "id": "white-map",
      "name": "知识结构",
      "type": "knowledge_map",
      "animation": "build",
      "skeleton": "knowledge-structure"
    },
    {
      "id": "white-closing",
      "name": "课程收束",
      "type": "closing",
      "animation": "focus",
      "skeleton": "closing-statement"
    }
