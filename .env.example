# ============ 应用 ============
APP_NAME=Mentorly
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# ============ JWT ============
# 至少 32 字节，生产环境务必更换
JWT_SECRET=mentorly-dev-secret-key-change-in-production
JWT_ISSUER=Mentorly
JWT_EXPIRE=168h

# ============ LLM（eino，OpenAI 兼容协议） ============
LLM_PROVIDER=spark
LLM_MODEL=spark-x2.6
# 注意：不要带 /chat/completions，eino 会自行拼接
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# 留空则不启用 AI 能力
LLM_API_KEY=

# ============ MySQL ============
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mentorly
# 显式 DSN 优先；留空则由上面三项拼装
DB_DSN=

# ============ 联网搜索（可选，留空即禁用） ============
# 支持 provider=tavily；api_key 为空时不注册搜索工具
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
